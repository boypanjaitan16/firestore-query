{
	"name": "@boyboni/firestore-query",
	"version": "0.1.0",
	"description": "Firestore bindings for TanStack Query: typed keys, realtime listeners in the query cache, cursor pagination, aggregates, and write hooks with automatic invalidation.",
	"keywords": [
		"firestore",
		"firebase",
		"tanstack-query",
		"react-query",
		"react",
		"realtime",
		"onSnapshot"
	],
	"license": "MIT",
	"author": "Boy Boni Panjaitan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/boypanjaitan16/firestore-query.git"
	},
	"homepage": "https://github.com/boypanjaitan16/firestore-query#readme",
	"bugs": {
		"url": "https://github.com/boypanjaitan16/firestore-query/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@10.11.0",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:emulator": "pnpm dlx firebase-tools@15.33.0 emulators:exec --config firebase.json --project demo-firestore-query --only firestore 'vitest run --config vitest.emulator.config.ts'",
		"check:package": "publint --strict && attw --pack . --profile esm-only",
		"prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:package"
	},
	"peerDependencies": {
		"@tanstack/react-query": "^5.101.0",
		"firebase": ">=10.0.0 <14.0.0",
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.5.14",
		"@firebase/rules-unit-testing": "^3.0.4",
		"@tanstack/react-query": "^5.104.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"firebase": "^10.14.1",
		"jsdom": "^27.4.0",
		"publint": "^0.3.25",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tsup": "^8.5.1",
		"typescript": "~5.9.3",
		"vitest": "^4.0.18"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"ignoredBuiltDependencies": [
			"protobufjs"
		]
	}
}
